--- !u!114 &2074584412
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2074584410}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d6fa75fc0d88274a92f6c3f9c33ea63, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u76F8\u6B21\u3050\u5973\u6027\u5931\u8E2A\u4E8B\u4EF6\u3002\u305D\u306E\u88CF\u306B\u6F5C\u3080\u8A98\u62D0\u7D44\u7E54\u3002
    \u3059\u3079\u3066\u306F\u3001\u3053\u306E\u53E4\u3073\u305F\u30A2\u30D1\u30FC\u30C8\u304B\u3089\u59CB\u307E\u308B\u2014\u2014 "
  C_1: "\u5973\u6027\u5931\u8E2A\u4E8B\u4EF6\u63A5\u8FDE\u53D1\u751F\uFF0C\u80CC\u540E\u9690\u85CF\u7740\u795E\u79D8\u7684\u8BF1\u62D0\u7EC4\u7EC7\u3002
    \u4E00\u5207\uFF0C\u90FD\u4ECE\u8FD9\u680B\u7834\u65E7\u7684\u516C\u5BD3\u5F00\u59CB\u2014\u2014 "
  C_2: "\u5973\u6027\u5931\u8E64\u4E8B\u4EF6\u63A5\u9023\u767C\u751F\uFF0C\u80CC\u5F8C\u96B1\u85CF\u8457\u795E\u7955\u7684\u8A98\u62D0\u7D44\u7E54\u3002
    \u4E00\u5207\uFF0C\u90FD\u5F9E\u9019\u68DF\u7834\u820A\u7684\u516C\u5BD3\u958B\u59CB\u2014\u2014 "
  E: "Women are disappearing one after another. Behind it all lurks an organized
    kidnapping ring. It all begins in this decaying apartment\u2014\u2014"
  K: "\uC5EC\uC131 \uC2E4\uC885 \uC0AC\uAC74\uC774 \uC5F0\uC774\uC5B4 \uBC1C\uC0DD\uD558\uACE0,
    \uADF8 \uBC30\uD6C4\uC5D0\uB294 \uC815\uCCB4\uBD88\uBA85\uC758 \uB0A9\uCE58 \uC870\uC9C1\uC774
    \uC228\uC5B4 \uC788\uB2E4. \uBAA8\uB4E0 \uAC83\uC740 \uC774 \uB0A1\uC740 \uC544\uD30C\uD2B8\uC5D0\uC11C
    \uC2DC\uC791\uB41C\uB2E4\u2014\u2014 "
  isTyped: 1
